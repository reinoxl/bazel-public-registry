load(
    "@com_github_mvukov_rules_ros2//ros2:cc_defs.bzl",
    "ros2_cpp_binary",
    "ros2_cpp_library",
)
load(
    "@com_github_mvukov_rules_ros2//ros2:interfaces.bzl",
    "ros2_interface_library",
)

ros2_interface_library(
    name = "robot_localization",
    srcs = [
        "srv/FromLL.srv",
        "srv/FromLLArray.srv",
        "srv/GetState.srv",
        "srv/SetDatum.srv",
        "srv/SetPose.srv",
        "srv/SetUTMZone.srv",
        "srv/ToLL.srv",
        "srv/ToggleFilterProcessing.srv",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@geographic_info//:geographic_msgs",
        "@ros2_common_interfaces//:geometry_msgs",
        "@ros2_rcl_interfaces//:builtin_interfaces",
    ],
)

ros2_cpp_library(
    name = "rl_lib",
    srcs = [
        "src/ekf.cpp",
        "src/filter_base.cpp",
        "src/filter_utilities.cpp",
        "src/navsat_conversions.hpp",
        "src/navsat_transform.cpp",
        "src/robot_localization_estimator.cpp",
        "src/ros_filter.cpp",
        "src/ros_filter_utilities.cpp",
        "src/ros_robot_localization_listener.cpp",
        "src/ukf.cpp",
    ],
    hdrs = glob(["include/**/*.hpp"]),
    copts = ["-std=c++17"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":cpp_robot_localization",
        "@boost.algorithm",
        "@boost.circular_buffer",
        "@eigen",
        "@geographic_info//:cpp_geographic_msgs",
        "@geographiclib",
        "@ros2_angles//:angles",
        "@ros2_common_interfaces//:cpp_diagnostic_msgs",
        "@ros2_common_interfaces//:cpp_geometry_msgs",
        "@ros2_common_interfaces//:cpp_nav_msgs",
        "@ros2_common_interfaces//:cpp_sensor_msgs",
        "@ros2_common_interfaces//:cpp_std_msgs",
        "@ros2_common_interfaces//:cpp_std_srvs",
        "@ros2_diagnostics//:cpp_diagnostic_updater",
        "@ros2_geometry2//:cpp_tf2_geometry_msgs",
        "@ros2_geometry2//:tf2",
        "@ros2_geometry2//:tf2_eigen",
        "@ros2_geometry2//:tf2_ros",
        "@ros2_message_filters//:message_filters",
        "@ros2_rclcpp//:rclcpp",
        "@ros2_rclcpp//:rclcpp_lifecycle",
        "@yaml-cpp",
    ],
)

ros2_cpp_binary(
    name = "ekf_node",
    srcs = ["src/ekf_node.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        ":rl_lib",
        "@ros2_rclcpp//:rclcpp",
        "@ros2_rclcpp//:rclcpp_lifecycle",
    ],
)

ros2_cpp_binary(
    name = "ukf_node",
    srcs = ["src/ukf_node.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        ":rl_lib",
        "@ros2_rclcpp//:rclcpp",
        "@ros2_rclcpp//:rclcpp_lifecycle",
    ],
)

ros2_cpp_binary(
    name = "navsat_transform_node",
    srcs = ["src/navsat_transform_node.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        ":rl_lib",
        "@ros2_rclcpp//:rclcpp",
    ],
)
